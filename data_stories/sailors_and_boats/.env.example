# Copy to .env and fill in. .env is git-ignored, here and by the repository root.
#
# Only the four shell scripts read this file (load_dotenv in _shared.sh).
# Streamlit, marimo and the Anthropic SDK do NOT read it on their own, so a key
# set any other way is invisible to the app.
#
# Everything except the "Ask in English" page works without a key, including the
# whole test suite -- it stubs the API client.

# Required only for the "Ask in English" page.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to the model named in src/text_to_sql.py.
ANTHROPIC_MODEL=claude-opus-5
