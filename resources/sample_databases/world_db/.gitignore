# Scoped Claude Code notes for this folder — not checked into Git.
# Also already covered by the repo-root .gitignore's "CLAUDE.md*"
# (that pattern has no leading slash, so it matches at every depth),
# but listed explicitly here too for a self-contained folder.
CLAUDE.md

# Notebook / tooling artifacts — regenerated by running the notebooks,
# never hand-edited, never committed.
__pycache__/
*.pyc
__marimo__/
.ipynb_checkpoints/

# NOTE: world.duckdb is intentionally NOT ignored — it's the shipped
# sample database (see README.md "How It Was Built"), not a build
# artifact regenerated on every run.
