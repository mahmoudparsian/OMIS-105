# Build artifact: the database is regenerated by ./create_duckdb.sh
# from 01_schema.sql and 02_records.sql. The trailing * also catches
# .duckdb.wal and hand-made .duckdb.save backups, which are stale
# the moment the schema changes and must never be committed.
*.duckdb*

# Python / tooling
__pycache__/
*.pyc
__marimo__/
