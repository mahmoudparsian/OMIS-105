# Build artifact: the database is regenerated by ./create_duckdb_database.sh
# from db_schema.sql and db_records.sql. The trailing * also catches
# .duckdb.wal and hand-made .duckdb.save backups, which are stale
# the moment the schema changes and must never be committed.
*.duckdb*

# Python / tooling
__pycache__/
*.pyc
__marimo__/
