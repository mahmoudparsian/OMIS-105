```

```sql
-- 10 orders (not all were successfully delivered)
INSERT INTO orders VALUES
    (1001, 1, '2024-10-05', 'Delivered'),
    (1002, 1, '2024-11-12', 'Delivered'),
    (1003, 2, '2024-10-18', 'Delivered'),
    (1004, 2, '2024-11-25', 'Cancelled'),
